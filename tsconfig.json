{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["*.ts"],          // ← ТОЛЬКО .ts файлы в корне
  "exclude": ["*.js", "node_modules", "dist"]  // ← ИСКЛЮЧАЕМ .js файлы
}